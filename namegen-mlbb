
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Random Name Generator MLBB - Dunia Games</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      color: #222;
      background: #fff;
    }
    .generator {
      max-width: 600px;
      margin: 0 auto;
      padding: 16px;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
    }
    h2 {
      margin: 0 0 6px;
      font-size: 19px;
      text-align: center;
    }
    .subtitle {
      margin: 0 0 16px;
      font-size: 13px;
      color: #666;
      text-align: center;
    }
    .filters {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .field label {
      display: block;
      margin-bottom: 6px;
      font-size: 13px;
      font-weight: bold;
    }
    select {
      width: 100%;
      min-width: 0;
      padding: 10px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      background: #fff;
      font-size: 14px;
    }
    .type-field {
      grid-column: 1 / -1;
    }
    .result {
      min-height: 100px;
      margin: 16px 0 12px;
      padding: 14px;
      border-radius: 9px;
      background: #f8fafc;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 8px;
    }
    .result-label {
      font-size: 12px;
      color: #64748b;
    }
    .result-name {
      font-size: 30px;
      font-weight: 800;
      color: #e11d48;
      overflow-wrap: anywhere;
    }
    .actions {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 8px;
    }
    button {
      min-height: 43px;
      border: 0;
      border-radius: 7px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
    }
    #generate {
      background: #e11d48;
      color: white;
    }
    #copy {
      background: #e5e7eb;
      color: #374151;
    }
    button:disabled {
      opacity: .5;
      cursor: not-allowed;
    }
    .message {
      min-height: 18px;
      margin: 10px 0 0;
      text-align: center;
      color: #64748b;
      font-size: 12px;
    }
    @media (max-width: 360px) {
      .generator { padding: 12px; }
      h2 { font-size: 17px; }
      .result-name { font-size: 26px; }
    }
  </style>
</head>
<body>
  <main class="generator">
    <h2>Random Name Generator MLBB</h2>
    <p class="subtitle">
      Temukan nickname keren untuk akun game kamu!
    </p>

    <div class="filters">
      <div class="field">
        <label for="length">Jumlah Karakter</label>
        <select id="length">
          <option value="all">Semua</option>
          <option value="4">4 Karakter</option>
          <option value="5">5 Karakter</option>
          <option value="6">6 Karakter</option>
        </select>
      </div>

      <div class="field">
        <label for="letter">Huruf Awal</label>
        <select id="letter">
          <option value="all">Semua Abjad</option>
        </select>
      </div>

      <div class="field type-field">
        <label for="type">Jenis Nama</label>
        <select id="type">
          <option value="all">Semua</option>
          <option value="Barat">Barat</option>
          <option value="Jepang">Jepang</option>
          <option value="Indonesia">Indonesia</option>
        </select>
      </div>
    </div>

    <div class="result" aria-live="polite">
      <span class="result-label">Nickname Kamu</span>
      <span class="result-name" id="result">?????</span>
    </div>

    <div class="actions">
      <button id="generate" type="button" disabled>
        Generate Nama
      </button>
      <button id="copy" type="button" disabled>
        Copy
      </button>
    </div>

    <p class="message" id="message" role="status">
      Memuat database nama...
    </p>
  </main>

  <script>
    (function () {
      "use strict";

      let names = [];
      let currentName = "";

      const lengthSelect = document.getElementById("length");
      const letterSelect = document.getElementById("letter");
      const typeSelect = document.getElementById("type");
      const result = document.getElementById("result");
      const message = document.getElementById("message");
      const generateBtn = document.getElementById("generate");
      const copyBtn = document.getElementById("copy");

      // Membuat pilihan huruf A sampai Z.
      for (const letter of "ABCDEFGHIJKLMNOPQRSTUVWXYZ") {
        const option = document.createElement("option");
        option.value = letter;
        option.textContent = letter;
        letterSelect.appendChild(option);
      }

      function getFilteredNames() {
        return names.filter(function (item) {
          const name = item.name;
          const lengthOK =
            lengthSelect.value === "all" ||
            Array.from(name).length === Number(lengthSelect.value);

          const letterOK =
            letterSelect.value === "all" ||
            name.toUpperCase().startsWith(letterSelect.value);

          const typeOK =
            typeSelect.value === "all" ||
            item.type === typeSelect.value;

          return lengthOK && letterOK && typeOK;
        });
      }

      function clearResult() {
        currentName = "";
        result.textContent = "?????";
        copyBtn.disabled = true;
        message.textContent = "";
      }

      function generateName() {
        const matches = getFilteredNames();

        if (matches.length === 0) {
          clearResult();
          message.textContent =
            "Tidak ada nama yang cocok. Coba filter lain.";
          return;
        }

        // Hindari mengulang hasil sebelumnya jika memungkinkan.
        let pool = matches.filter(function (item) {
          return item.name !== currentName;
        });

        if (pool.length === 0) {
          pool = matches;
        }

        const randomIndex = Math.floor(Math.random() * pool.length);
        currentName = pool[randomIndex].name;

        result.textContent = currentName;
        copyBtn.disabled = false;
        message.textContent = "";
      }

      async function copyName() {
        if (!currentName) return;

        try {
          await navigator.clipboard.writeText(currentName);
          message.textContent = "Nickname berhasil disalin!";
        } catch (error) {
          message.textContent =
            "Gagal menyalin otomatis. Silakan salin nama secara manual.";
        }
      }

      // Memuat database JSON dari folder yang sama.
      fetch("./names-mlbb.json")
        .then(function (response) {
          if (!response.ok) {
            throw new Error("File JSON tidak ditemukan.");
          }
          return response.json();
        })
        .then(function (data) {
          if (!Array.isArray(data)) {
            throw new Error("Format JSON harus berupa array.");
          }

          const seen = new Set();

          names = data.filter(function (item) {
            if (
              !item ||
              typeof item.name !== "string" ||
              typeof item.type !== "string"
            ) {
              return false;
            }

            const name = item.name.trim();
            const key = name.toLowerCase();

            if (!name || seen.has(key)) return false;

            seen.add(key);
            item.name = name;
            return true;
          });

          generateBtn.disabled = names.length === 0;
          message.textContent = names.length
            ? "Pilih filter, lalu klik Generate Nama."
            : "Database nama masih kosong.";
        })
        .catch(function () {
          message.textContent =
            "Database gagal dimuat. Periksa file names-mlbb.json.";
        });

      generateBtn.addEventListener("click", generateName);
      copyBtn.addEventListener("click", copyName);

      [lengthSelect, letterSelect, typeSelect].forEach(function (select) {
        select.addEventListener("change", clearResult);
      });
    })();
  </script>
</body>
</html>
